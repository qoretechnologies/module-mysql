Subject: Declare every caller-clobbered ARM64 register across coroutine switches

diff --git a/libmariadb/ma_context.c b/libmariadb/ma_context.c
index 7b0083a..f480b38 100644
--- a/libmariadb/ma_context.c
+++ b/libmariadb/ma_context.c
@@ -755,7 +755,7 @@ my_context_spawn(struct my_context *c, void (*f)(void *), void *d)
        [stack] "+r" (stack)
      : [save] "r" (save)
      : "x3", "x4", "x5", "x6", "x7",
-       "x9", "x10", "x11", "x14", "x15",
+       "x8", "x9", "x10", "x11", "x12", "x14", "x15", "x16", "x17",
 #if defined(__linux__) && !defined(__ANDROID__)
        "x18",
 #endif
@@ -864,7 +864,7 @@ my_context_continue(struct my_context *c)
      : [ret] "=r" (ret)
      : [save] "r" (save)
      : "x1", "x2", "x3", "x4", "x5", "x6", "x7",
-       "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+       "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17",
 #if defined(__linux__) && !defined(__ANDROID__)
        "x18",
 #endif
@@ -946,7 +946,7 @@ my_context_yield(struct my_context *c)
      :
      : [save] "r" (save)
      : "x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7",
-       "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+       "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17",
 #if defined(__linux__) && !defined(__ANDROID__)
        "x18",
 #endif
