Package: qore-mysql-module
Architecture: any
Depends: ${qore:Depends},
         ${shlibs:Depends},
         ${misc:Depends}
Suggests: qore-mysql-module-doc
Description: MySQL and MariaDB database driver for Qore
 This module connects Qore's DBI API to MySQL and MariaDB databases using
 MariaDB Connector/C. It supports prepared statements, transactions, Unicode,
 columnar results and guarded native bulk loading.

Package: qore-mysql-module-doc
Section: doc
Architecture: all
Multi-Arch: foreign
Build-Profiles: <!nodoc>
Depends: ${misc:Depends}
Suggests: qore-mysql-module
Description: documentation and examples for Qore's MySQL/MariaDB driver
 This package contains the HTML API reference and example tests for Qore's
 MySQL/MariaDB database driver.
